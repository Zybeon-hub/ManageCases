# Case Workflow Management System - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Security (REQUIRED - Change in production!)
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Data Configuration
DATA_DIR=./data
BACKUP_INTERVAL=300000
MAX_BACKUPS=10

# User Limits
MAX_USERS=10
MAX_ADMIN_USERS=2
MAX_MANAGER_USERS=2
MAX_LEAD_USERS=2
MAX_OPS_USERS=4

# Security Settings
PASSWORD_MIN_LENGTH=6
SESSION_TIMEOUT=3600000

# Optional: Future Expansion
# DATABASE_URL=postgresql://user:password@host:port/database
# REDIS_URL=redis://user:password@host:port
